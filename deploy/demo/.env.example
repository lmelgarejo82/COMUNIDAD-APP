# Copy to /opt/tavalink-demo/.env, replace every value, then chmod 600.
POSTGRES_USER=tavalink_demo
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
POSTGRES_DB=tavalink_demo
JWT_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_BYTES
INVITATION_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_VALUE
DEMO_HTTP_PORT=18080
