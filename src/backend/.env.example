PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comunidad
# Opcional: si se omite, se usa src/backend/uploads.
# UPLOAD_DIR=./uploads
JWT_SECRET=
# Para el primer despliegue, usar el JWT_SECRET seguro anterior y rotar JWT_SECRET al mismo tiempo.
INVITATION_TOKEN_SECRET=
JWT_EXPIRES_IN=7d
PUBLIC_APP_URL=http://localhost:5173
# Configuración SMTP: definir EMAIL_USER y EMAIL_PASS para entrega real.
# El SMTP efímero de Ethereal es solo para pruebas y no cubre la preparación del proveedor piloto.
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
MP_ACCESS_TOKEN=
MP_SUCCESS_URL=http://localhost:5173/expensas
MP_FAILURE_URL=http://localhost:5173/expensas
MP_PENDING_URL=http://localhost:5173/expensas
MP_WEBHOOK_URL=http://localhost:3000/api/webhooks/mercadopago
QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
# Vacío para acceso directo; detrás de proxy, usar únicamente su IP exacta.
TRUST_PROXY_IP=
DEEPSEEK_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
